# Target environment: qa | staging | production
ENV=qa

# Optional: override the environment base URL without changing code
# BASE_URL=https://qa-baersupply.vercel.app

# Vercel Protection Bypass for Automation (never commit real values)
# Always also sends User-Agent: jmter-elastic-search
# QA: shared or QA-specific secret (optional if UA allowlist is enough)
VERCEL_AUTOMATION_BYPASS_SECRET=
# VERCEL_AUTOMATION_BYPASS_SECRET_QA=
# Production: required — secret from the PRODUCTION Vercel project
# VERCEL_AUTOMATION_BYPASS_SECRET_PROD=

# Optional: fail runtime-errors tests on known EXPECTED application defects (e.g. React #418)
# RUNTIME_ERRORS_STRICT=1

# Analytics workers (1–4). Default: 1 for full analytics; smoke defaults to 3
# ANALYTICS_WORKERS=2

# Analytics profile: smoke | full (omit = full dataset)
# ANALYTICS_PROFILE=smoke

# Optional: run analytics modules sequentially (lower disk use)
# ANALYTICS_SEQUENTIAL=1

# SKU → PLP cache validation (npm run test:sku-plp)
# SKU_DATASET=src/test-data/sku-plp/skus.json
# SKU_LIMIT=20
# SKU_CACHE_SEQUENCES=0
# SKU_CLEAN_BROWSER=1
# SKU_SCREENSHOTS=0
# SKU_INCLUDE_FAILS=1
