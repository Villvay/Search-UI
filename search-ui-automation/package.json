{
  "name": "search-ui-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI automation framework for Search UI",
  "private": true,
  "scripts": {
    "test": "playwright test tests/framework-validation.spec.ts --project=desktop-1440",
    "test:headed": "playwright test tests/framework-validation.spec.ts --project=desktop-1440 --headed",
    "test:debug": "playwright test tests/framework-validation.spec.ts --project=desktop-1440 --debug",
    "test:clean": "node scripts/clean-test-artifacts.mjs",
    "test:report": "node -e \"const fs=require('fs');const p='reports/html/index.html';if(!fs.existsSync(p)){console.error('Missing '+p);process.exit(1);} console.log('Report: '+require('path').resolve(p));\" && open reports/html/index.html",
    "test:summary": "node scripts/generate-search-ui-report.mjs && node scripts/generate-search-ui-html.mjs",
    "test:search-ui": "node scripts/run-search-ui.mjs",
    "test:search-ui:dashboard": "node scripts/run-search-ui-dashboard.mjs",
    "test:smoke": "playwright test --project=desktop-1440 --grep @smoke --retries=0",
    "test:desktop": "playwright test --project=desktop-1440 --project=desktop-1280",
    "test:desktop-1440:browsers": "playwright test --project=desktop-1440 --project=desktop-1440-firefox",
    "test:analytics:desktop-1440:browsers": "node scripts/run-analytics.mjs --project=desktop-1440 --project=desktop-1440-firefox",
    "test:tablet": "playwright test --project=tablet-1024 --project=tablet-768",
    "test:mobile": "playwright test --project=mobile-390 --project=mobile-375",
    "test:responsive": "playwright test --grep @responsive",
    "test:on-type": "playwright test src/modules/on-type/tests/on-type.spec.ts",
    "test:suggestions": "playwright test src/modules/suggestions/tests/suggestions.spec.ts",
    "test:on-enter": "playwright test src/modules/on-enter/tests/on-enter.spec.ts",
    "test:related-searches": "playwright test src/modules/related-searches/tests",
    "test:filters": "playwright test src/modules/filters-facets/tests/filters-facets.spec.ts --project=desktop-1440 --project=desktop-1280",
    "test:filters:responsive": "playwright test src/modules/filters-facets/tests/filters-facets.spec.ts --project=desktop-1440 --project=desktop-1280 --project=tablet-1024 --project=tablet-768 --project=mobile-390 --project=mobile-375",
    "test:sorting": "playwright test src/modules/sorting/tests/sorting.spec.ts --project=desktop-1440 --project=desktop-1280",
    "test:sorting:responsive": "playwright test src/modules/sorting/tests/sorting.spec.ts --project=desktop-1440 --project=desktop-1280 --project=tablet-1024 --project=tablet-768 --project=mobile-390 --project=mobile-375",
    "test:sku-plp": "playwright test src/modules/sku-plp-cache/tests/sku-plp-cache.spec.ts --project=desktop-1440 --retries=0",
    "test:sku-plp:dashboard": "node scripts/generate-sku-plp-dashboard.mjs",
    "test:analytics": "node scripts/run-analytics.mjs --project=desktop-1440",
    "test:analytics:smoke": "node scripts/run-analytics.mjs --smoke --project=desktop-1440",
    "test:analytics:batched": "node scripts/run-analytics-batched.mjs",
    "test:analytics:on-type": "playwright test src/modules/on-type/tests/on-type-analytics.spec.ts --project=desktop-1440",
    "test:analytics:suggestions": "playwright test src/modules/suggestions/tests/suggestions-analytics.spec.ts --project=desktop-1440",
    "test:analytics:on-enter": "playwright test src/modules/on-enter/tests/on-enter-analytics.spec.ts --project=desktop-1440",
    "test:analytics:report": "node scripts/generate-analytics-report.mjs",
    "test:daily": "playwright test --project=desktop-1440 --project=mobile-390 --grep @analytics",
    "test:nightly": "playwright test --grep \"@responsive|@analytics\""
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}
