# Target environment: qa | staging | production
# Default QA host is https://wurthlac.com (public Louis & Company storefront).
ENV=qa

# Optional: override the environment base URL without changing code.
# Staging and production hosts are not hard-coded — set BASE_URL when using those ENV values.
# BASE_URL=https://wurthlac.com

# Optional Vercel Protection Bypass when targeting a preview host (never commit real values).
# VERCEL_AUTOMATION_BYPASS_SECRET=
# VERCEL_AUTOMATION_BYPASS_SECRET_QA=

# Headed smoke (visible browser) — also: npm run test:smoke:headed
# HEADED=1
# HEADLESS=true

# Optional: fail runtime-errors tests on classified EXPECTED application defects
# RUNTIME_ERRORS_STRICT=1
