# Target environment: qa | staging | production
ENV=qa

# Optional: override the environment base URL without changing code
# BASE_URL=https://qa-baersupply.vercel.app

# Preferred override for this module
# SECURITY_REVIEW_BASE_URL=https://next-baersupply.vercel.app
# SECURITY_REVIEW_FAIL_ON=high
# SECURITY_REVIEW_MAX_PAGES=8
# SECURITY_REVIEW_PATHS=/cart,/sign-in

# Optional QA Vercel Protection Bypass (never commit real values)
# VERCEL_AUTOMATION_BYPASS_SECRET=
# VERCEL_AUTOMATION_BYPASS_SECRET_QA=

# Headless by default. Use --headed or HEADED=1 for a visible browser.
# HEADED=1
